# Environment variables for Codeforces Time Tale Backend

# Server configuration
PORT=put_it_here
#can be anything, but HF tends to listen on 7860

# FastAPI backend
FASTAPI_URL=https://your-fastapi-server.com
TIME_TALE_GET_TOKEN=your_bearer_token_here

# AI API Key (REQUIRED for funny roasts)
# Currently only Groq is wired into the request flow.
# Get your key from: https://groq.com/console
GROQ_API_KEY=your_groq_api_key_here

# Note: Google Gemini support exists in the codebase but is not currently
# used in the request flow (import is commented out in controllers/home.controllers.js).
# To enable Gemini, uncomment the Gemini import and remove the Groq import in that file.
# GEMINI_API_KEY=your_gemini_api_key_here